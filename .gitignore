# ==============================
# 1. DEPENDENCIES (Heavy folders)
# ==============================
node_modules/
/.pnp
.pnp.js

# ==============================
# 2. ENVIRONMENT & SECRETS (Never push these!)
# ==============================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==============================
# 3. PRODUCTION BUILD OUTPUTS
# ==============================
/dist
/build
/out
/.next
/.nuxt
/.vercel

# ==============================
# 4. LOGS & DEBUGGING
# ==============================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# 5. OS & EDITOR FILES (Junk files)
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================
# 6. TESTING & COVERAGE
# ==============================
/coverage
/.nyc_output

